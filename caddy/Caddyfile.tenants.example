# Shared Caddy config for multi-tenant CRM Academy hosting. The s3 block below is static: one
# shared MinIO fronts every tenant's bucket, selected by bucket name in the request path, not by
# hostname, so it needs no per-tenant block. Per-tenant site blocks are appended below by
# scripts/provision-tenant.sh between BEGIN/END TENANT markers, and removed by
# scripts/deprovision-tenant.sh using the same markers. Do not hand-edit a generated block; edit
# anything above the first marker freely. See docs/deploy-multi-tenant.md.
#
# TLS is NOT managed here: this VPS already terminates TLS at the host nginx with a wildcard
# cert for *.crm.estrategistacrm.com.br (acme.sh, DNS-01), reused instead of per-site ACME here
# because nginx already owns host ports 80/443 for other products on this box. Caddy only does
# Host-header routing to each tenant's containers over plain HTTP on an internal-only port
# (see docker-compose.shared.yml). auto_https off: without it, Caddy would still try to obtain
# its own certs for these domain-shaped addresses and would fail (it can't bind 80/443, and
# doesn't need to).
#
# trusted_proxies: host nginx is the only client of this Caddy, so every request arrives from a
# private address. Trusting private ranges (and taking the right-most untrusted hop, which is the
# address nginx itself appended) lets {client_ip} be the real visitor; each tenant block then
# forwards it as X-Forwarded-For so the app's per-IP rate limits apply per visitor, not per tenant.
# Requires nginx to send: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
{
	auto_https off
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

http://s3.{$BASE_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "sandbox; default-src 'none'; frame-ancestors 'none'"
		-Server
	}

	# MinIO's admin API shares this port and is guarded only by the root credentials.
	respond /minio/admin* 403

	reverse_proxy shared-minio:9000
}
